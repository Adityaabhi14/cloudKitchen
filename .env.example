# ==============================================================================
# VINDU RUCHULU — TELANGANA & ANDHRA DAILY CLOUD KITCHEN
# ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Copy this file to .env.local and populate the values for your environment:
# cp .env.example .env.local

# ------------------------------------------------------------------------------
# 1. APPLICATION & SERVER CONFIGURATION
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. BRAND & KITCHEN METADATA
# ------------------------------------------------------------------------------
NEXT_PUBLIC_KITCHEN_NAME="Vindu Ruchulu"
NEXT_PUBLIC_KITCHEN_TAGLINE="Authentic Telangana & Andhra Daily Feast Kitchen"
NEXT_PUBLIC_KITCHEN_CITY="Hyderabad"
NEXT_PUBLIC_SUPPORT_PHONE="+91 98765 43210"
NEXT_PUBLIC_SUPPORT_EMAIL="orders@vinduruchulu.com"

# ------------------------------------------------------------------------------
# 3. DATABASE & PERSISTENCE
# ------------------------------------------------------------------------------
# Path to the JSON relational store (defaults to ./database/kitchen_relational_db.json)
DATABASE_URL=file:./database/kitchen_relational_db.json

# ------------------------------------------------------------------------------
# 4. SECURITY & AUTHENTICATION SECRETS
# ------------------------------------------------------------------------------
# Secret key used for signing administrative JWT session tokens and customer cookies
JWT_SECRET=vindu_kitchen_secure_secret_token_2026_super_key
SESSION_COOKIE_NAME=vindu_customer_session
ADMIN_COOKIE_NAME=vindu_admin_session

# Default admin bootstrap credentials (for first-time setup / fallback)
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=admin123

# ------------------------------------------------------------------------------
# 5. GOOGLE AUTHENTICATION (CUSTOMER LOGIN)
# ------------------------------------------------------------------------------
# Google Cloud Console OAuth 2.0 Client ID for Google One Tap / Continue with Google
# Create at: https://console.cloud.google.com/apis/credentials
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# ------------------------------------------------------------------------------
# 6. RAZORPAY PAYMENT GATEWAY
# ------------------------------------------------------------------------------
# Razorpay API Keys (Leave empty to use built-in Mock Simulator for instant local testing)
# Generate test keys at: https://dashboard.razorpay.com/app/keys
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_yourKeyIdHere
RAZORPAY_KEY_ID=rzp_test_yourKeyIdHere
RAZORPAY_KEY_SECRET=yourRazorpayKeySecretHere
RAZORPAY_WEBHOOK_SECRET=yourRazorpayWebhookSecretHere

# ------------------------------------------------------------------------------
# 7. DELIVERY LOGISTICS & THRESHOLDS (DEFAULT FALLBACKS)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_DEFAULT_DELIVERY_FEE=40
NEXT_PUBLIC_FREE_DELIVERY_THRESHOLD=600
NEXT_PUBLIC_MINIMUM_ORDER_AMOUNT=200

# ------------------------------------------------------------------------------
# 8. SMS & WHATSAPP NOTIFICATION SERVICES (OPTIONAL)
# ------------------------------------------------------------------------------
# WhatsApp Cloud API or Twilio credentials for instant booking confirmations
WHATSAPP_API_KEY=
WHATSAPP_PHONE_NUMBER_ID=
FAST2SMS_API_KEY=
