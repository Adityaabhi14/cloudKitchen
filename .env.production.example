# ==============================================================================
# VINDU RUCHULU — PRODUCTION ENVIRONMENT TEMPLATE (.env.production.example)
# ==============================================================================

# Server & Domain
NODE_ENV=production
PORT=3000
NEXT_PUBLIC_APP_URL=https://vinduruchulu.com

# Kitchen Brand Info
NEXT_PUBLIC_KITCHEN_NAME="Vindu Ruchulu"
NEXT_PUBLIC_KITCHEN_TAGLINE="Authentic Telangana & Andhra Daily Feast Kitchen"
NEXT_PUBLIC_KITCHEN_CITY="Hyderabad"
NEXT_PUBLIC_SUPPORT_PHONE="+91 98765 43210"
NEXT_PUBLIC_SUPPORT_EMAIL="orders@vinduruchulu.com"

# Relational Database Storage Path
DATABASE_URL=file:./database/kitchen_relational_db.json

# Security & Secrets (Replace with strong random secrets in production)
JWT_SECRET=generate_strong_64_char_random_hex_secret_key_here
SESSION_COOKIE_NAME=vindu_customer_session
ADMIN_COOKIE_NAME=vindu_admin_session

# Customer Google OAuth (Production Google Cloud Console Credentials)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-production-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-production-google-client-secret

# Production Razorpay Keys (Live mode)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_yourLiveKeyId
RAZORPAY_KEY_ID=rzp_live_yourLiveKeyId
RAZORPAY_KEY_SECRET=yourLiveKeySecret
RAZORPAY_WEBHOOK_SECRET=yourLiveWebhookSecret

# Logistics Defaults
NEXT_PUBLIC_DEFAULT_DELIVERY_FEE=40
NEXT_PUBLIC_FREE_DELIVERY_THRESHOLD=600
NEXT_PUBLIC_MINIMUM_ORDER_AMOUNT=200

# WhatsApp / SMS Notifications
WHATSAPP_API_KEY=
WHATSAPP_PHONE_NUMBER_ID=
FAST2SMS_API_KEY=
